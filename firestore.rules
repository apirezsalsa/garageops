rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.email.matches('.*apirezsalsa.*') ||
        request.auth.token.email == 'demo@garageops.io' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Reglas para la colección users
    // Permite lectura y escritura a cada usuario sobre su propio documento,
    // y acceso de lectura/escritura completo a administradores para el Backoffice
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && (request.resource.data.role != 'admin' || isAdmin());
      allow update: if request.auth != null && (
        (request.auth.uid == userId && request.resource.data.role == resource.data.role) ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }

    // Reglas para vehicles
    // Los admins pueden leer/escribir todos los vehículos (conteo del Backoffice y Modo Inspección)
    match /vehicles/{vehicleId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reglas para maintenances
    match /maintenances/{maintenanceId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reglas para parts
    match /parts/{partId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if request.auth != null && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Reglas para auditLogs (registro de acciones realizadas por admins en Modo Inspección)
    // Solo los admins pueden crear y leer entradas; nadie puede modificar/borrar un log ya creado
    match /auditLogs/{logId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    // Reglas para plans (planes de suscripción configurables desde el Backoffice)
    // Lectura pública (se muestran en Ajustes de la app y en los precios de la landing); solo admins escriben
    match /plans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Reglas para transactions (histórico de eventos de facturación de Stripe).
    // Solo el webhook (Admin SDK, que ignora estas reglas) escribe. En lectura: los admins ven todo
    // desde el Backoffice, y cada usuario puede ver únicamente sus propias transacciones.
    match /transactions/{transactionId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // Reglas para errorLogs (monitorización de errores del frontend, ver src/monitoring.js).
    // Cualquiera puede crear un log (incluso sin sesión: un error puede ocurrir antes de iniciar sesión),
    // pero solo con la forma esperada. Solo los admins pueden leerlos; nadie puede modificarlos ni borrarlos.
    match /errorLogs/{logId} {
      allow create: if request.resource.data.keys().hasOnly(['message', 'stack', 'url', 'userAgent', 'uid', 'extra', 'createdAt'])
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
