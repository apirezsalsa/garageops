{
  "expo": {
    "name": "GarageOps",
    "slug": "GarageOps",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "package": "com.apirezsalsa.GarageOps",
      "softwareKeyboardLayoutMode": "adjustResize",
      "statusBar": {
        "translucent": true,
        "barStyle": "light-content"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GarageOps to access your photos to save vehicle and receipt images."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "4914b85b-7440-49e0-af2e-02cb2a26cb07"
      }
    }
  }
}